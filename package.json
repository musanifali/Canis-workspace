{
  "name": "workspace-engine",
  "private": true,
  "version": "0.0.0",
  "description": "Workspace Engine \u2014 natural language to safe, saved, native screens. Built on Tambo (consumed, never forked).",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "packageManager": "npm@10.9.7",
  "scripts": {
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "build": "turbo run build",
    "verify:artifacts": "node scripts/smoke-artifacts.mjs",
    "size": "npm run size --workspace=@ticora/react",
    "changeset": "changeset",
    "release:version": "changeset version",
    "pack:canary": "mkdir -p canary-dist && npm pack --workspace @ticora/core --workspace @ticora/react --workspace @ticora/ui --workspace @ticora/client --workspace @ticora/cli --workspace @ticora/devtools --pack-destination canary-dist",
    "api-surface": "node scripts/api-surface.mjs --write",
    "api-surface:check": "node scripts/api-surface.mjs --check",
    "compat": "node scripts/compat-suite.mjs",
    "check:private": "node scripts/check-private.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "turbo": "^2.3.0",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "nextra": {
      "zod": "4.1.12"
    },
    "nextra-theme-docs": {
      "zod": "4.1.12"
    }
  }
}
