{
  "name": "@ticora/cli",
  "version": "0.3.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/musanifali/Canis-workspace.git",
    "directory": "packages/cli"
  },
  "homepage": "https://ticora-docs.vercel.app",
  "bugs": {
    "url": "https://github.com/musanifali/Canis-workspace/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "ticora — vendor CLI for the Workspace Engine. `contracts diff` gates breaking contract changes against saved workspaces; `contracts lint` checks contract quality. All IO lives here; validation reuses @ticora/core's validateSpec unchanged.",
  "type": "module",
  "bin": {
    "ticora": "./dist/bin/ticora.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ticora/client": "0.3.0",
    "@ticora/core": "0.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "zod": "^3.25.0"
  }
}
